#menuOverlay {
    position: absolute;
    transition: left 0.5s;
}

.stopRecordingButton {
    background-color: rgb(224, 0, 0);
}

.stopRecordingButton:hover {
    background-color: rgb(255, 0, 0);
}

.stopRecordingButton:focus {
    background-color: rgb(255, 0, 0);
}

#songListEntryButton {
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 10px;
    padding-bottom: 10px;
}

#songListEntryLabel {
    white-space: normal;
    -unity-text-align: middle-left;
}