<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="MicrophoneUi" src="project://database/Assets/Scenes/MainScene/MicrophoneUi.uxml?fileID=9197481963319205126&amp;guid=5f84f7bcc7710ee4fa080095d579c557&amp;type=3#MicrophoneUi" />
    <ui:Template name="SongListUi" src="project://database/Assets/Scenes/MainScene/SongListUi.uxml?fileID=9197481963319205126&amp;guid=0485cb8517dc0464996e2aa2f6ea1e37&amp;type=3#SongListUi" />
    <ui:Template name="SongDetailsUi" src="project://database/Assets/Scenes/MainScene/SongDetailsUi.uxml?fileID=9197481963319205126&amp;guid=3dbba0a02e822b44cb898f512e23a1c2&amp;type=3#SongDetailsUi" />
    <ui:Template name="InputSimulationUi" src="project://database/Assets/Scenes/MainScene/InputSimulationUi.uxml?fileID=9197481963319205126&amp;guid=8207c240e20c0e546b018010579d8422&amp;type=3#InputSimulationUi" />
    <ui:Template name="MainSceneMenuUi" src="project://database/Assets/Scenes/MainScene/MenuUi.uxml?fileID=9197481963319205126&amp;guid=ada12ffedb0785e43aa19245961c4d1f&amp;type=3#MenuUi" />
    <ui:Template name="GameRoundModifierDialogUi" src="project://database/Packages/playshared/Runtime/GameRounds/GameRoundModifierDialogUi.uxml?fileID=9197481963319205126&amp;guid=880dc6db80bf20f4ca31b5dcaf892586&amp;type=3#GameRoundModifierDialogUi" />
    <ui:VisualElement name="background" style="width: 100%; height: 100%; background-image: url(&apos;project://database/Assets/Common/Graphics/Backgrounds/[bg-main]blue_plain.jpg?fileID=21300000&amp;guid=4fd0c0cd5661e0b45aee082182ae1a93&amp;type=3#[bg-main]blue_plain&apos;); padding-left: 1px; padding-right: 1px; padding-top: 1px; padding-bottom: 1px;">
        <ui:VisualElement name="titleContainer" style="align-items: center; width: 100%; justify-content: flex-start; top: auto; flex-direction: row; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px;">
            <ui:VisualElement name="titleImageAndText" style="flex-direction: row; align-items: center; flex-grow: 1; justify-content: center;">
                <ui:VisualElement name="titleAndDescription">
                    <ui:Label text="UltraStar Play  Companion" name="sceneTitle" class="titleText" style="-unity-font-style: bold;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button display-tooltip-when-elided="true" name="showMenuButton" style="align-items: center; justify-content: center; width: 48px; height: 48px; flex-grow: 0; margin-left: 0; margin-right: 0; margin-top: 5px; margin-bottom: 5px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;">
                <MaterialIcon icon="settings" name="menuIcon" />
            </ui:Button>
        </ui:VisualElement>
        <ButtonGroup name="tabGroup" direction="Horizontal" class="onlyVisibleWhenConnected" style="flex-direction: row;">
            <ui:Button display-tooltip-when-elided="true" name="showMicViewButton">
                <MaterialIcon tabindex="-1" icon="mic" name="micIcon" />
            </ui:Button>
            <ui:Button display-tooltip-when-elided="true" name="showSongViewButton">
                <MaterialIcon tabindex="-1" name="songListIcon" icon="queue_music" />
            </ui:Button>
            <ui:Button display-tooltip-when-elided="true" name="showInputSimulationButton">
                <MaterialIcon tabindex="-1" name="simulateInputIcon" icon="keyboard" />
            </ui:Button>
        </ButtonGroup>
        <ui:VisualElement name="tabContentContainer" class="onlyVisibleWhenConnected" style="flex-grow: 4;">
            <ui:VisualElement name="micViewContainer" style="flex-grow: 1; justify-content: center; position: absolute; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; display: flex; width: 100%; height: 100%;">
                <ui:Instance template="MicrophoneUi" name="MicrophoneUi" style="flex-grow: 1;" />
            </ui:VisualElement>
            <ui:VisualElement name="songViewContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; top: -1px; left: 0; display: none;">
                <ui:VisualElement name="songListContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                    <ui:Instance template="SongListUi" name="SongListUi" />
                </ui:VisualElement>
                <ui:VisualElement name="songDetailsContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
                    <ui:Instance template="SongDetailsUi" name="SongDetailsUi" style="flex-grow: 1;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="inputSimulationContainer" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; top: -1px; left: 0; display: none; align-items: center; justify-content: center;">
                <ui:Instance template="InputSimulationUi" name="InputSimulationUi" style="width: 100%; height: 100%;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="connectionViewContainer" class="onlyVisibleWhenNotConnected" style="justify-content: center; align-items: center; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; flex-grow: 1; display: none;">
            <ui:Label text="Connecting..." display-tooltip-when-elided="true" name="connectionStatusText" style="-unity-text-align: middle-center; margin-bottom: 20px;" />
            <ui:Label text="Received error" display-tooltip-when-elided="true" name="serverErrorResponseText" style="-unity-text-align: middle-left; color: rgb(255, 0, 0); white-space: normal; width: 100%; margin-bottom: 20px;" />
            <ui:Label text="There are connection issues." display-tooltip-when-elided="true" name="connectionThroubleshootingText" style="-unity-text-align: middle-left; color: rgb(255, 152, 0); white-space: normal; width: 100%; margin-bottom: 20px;" />
        </ui:VisualElement>
        <ui:VisualElement name="menuOverlay" style="width: 100%; height: 100%; flex-direction: row; position: absolute; display: none;">
            <ui:Button display-tooltip-when-elided="true" name="hiddenCloseMenuButton" class="transparentBackgroundColor" style="flex-grow: 1; height: 100%; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;" />
            <ui:VisualElement name="menuOverlayContent" style="background-color: rgba(0, 0, 0, 0.75); width: 80%; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px;">
                <ui:Instance template="MainSceneMenuUi" name="MainSceneMenuUi" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="modifierDialogOverlay" class="overlay" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); display: none;">
            <ui:Instance template="GameRoundModifierDialogUi" name="GameRoundModifierDialogUi" class="overlayBackground roundCorners" style="width: 100%; height: 100%; max-width: 90%; max-height: 90%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
