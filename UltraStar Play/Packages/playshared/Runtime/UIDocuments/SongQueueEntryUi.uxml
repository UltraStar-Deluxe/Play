<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="SongSelectGameRoundSongEntryUi" src="project://database/Packages/playshared/Runtime/UIDocuments/SongQueueSongEntryUi.uxml?fileID=9197481963319205126&amp;guid=fb881350f700eba4b80febd82795eb70&amp;type=3#SongQueueSongEntryUi" />
    <ui:Template name="SongSelectGameRoundPlayerEntryUi" src="project://database/Packages/playshared/Runtime/UIDocuments/SongQueuePlayerEntryUi.uxml?fileID=9197481963319205126&amp;guid=ccb6fef294a278444a611bf2cff48729&amp;type=3#SongQueuePlayerEntryUi" />
    <ui:VisualElement name="songQueueEntryUiRoot" class="roundCorners roundedCorners outline" style="flex-direction: column; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; width: 100%;">
        <ui:VisualElement name="row" style="background-color: rgba(0, 0, 0, 0); flex-direction: row;">
            <ui:Button display-tooltip-when-elided="true" name="deleteButton" class="squareButton transparentBackgroundColor" style="margin-right: 5px;">
                <MaterialIcon tabindex="-1" icon="delete" name="deleteIcon" picking-mode="Ignore" />
            </ui:Button>
            <ui:Instance template="SongSelectGameRoundSongEntryUi" name="SongQueueSongEntryUi" style="align-items: flex-start;" />
            <ui:Button display-tooltip-when-elided="true" name="toggleMedleyButton" class="squareButton transparentBackgroundColor" style="top: -20px; margin-left: auto;">
                <MaterialIcon tabindex="-1" name="isMedleyIcon" icon="link" picking-mode="Ignore" style="position: absolute;" />
                <MaterialIcon tabindex="-1" name="isNoMedleyIcon" icon="link_off" picking-mode="Ignore" style="position: absolute;" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="row" style="background-color: rgba(0, 0, 0, 0); flex-direction: row; margin-top: 5px;">
            <ui:VisualElement name="playerEntryList" style="background-color: rgba(0, 0, 0, 0); flex-direction: row; flex-wrap: wrap; width: 100%;">
                <ui:Instance template="SongSelectGameRoundPlayerEntryUi" name="SongQueuePlayerEntryUi" />
                <ui:Instance template="SongSelectGameRoundPlayerEntryUi" name="SongQueuePlayerEntryUi" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
