<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="roundModifierDialogUiRoot" style="background-color: rgba(0, 0, 0, 0); padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; flex-grow: 1;">
        <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1">
            <ui:VisualElement name="finishConditionContainer" class="bottomLineSeparator" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                <ItemPicker name="finishConditionPicker" label="Finish Condition" class="controlWithLabelVertical" style="margin-bottom: 8px; width: 100%;" />
                <ItemPicker name="finishConditionPointsPicker" style="flex-direction: row; margin-bottom: 8px;" />
            </ui:VisualElement>
            <ui:VisualElement name="unconditionalModifierContainer" class="bottomLineSeparator" style="background-color: rgba(0, 0, 0, 0); margin-bottom: 5px;">
                <ui:Toggle label="Pass the Microphone" name="passTheMicToggle" value="false" style="margin-bottom: 8px; margin-top: 8px;" />
                <ui:Toggle label="Short song" name="shortSongToggle" value="false" style="margin-bottom: 8px;" />
            </ui:VisualElement>
            <ui:VisualElement name="conditionalModifierContainer" style="background-color: rgba(0, 0, 0, 0);">
                <ui:Toggle label="Hide lyrics" name="hideLyricsToggle" style="margin-bottom: 8px;" />
                <ui:Toggle label="Hide notes" name="hideNotesToggle" style="margin-bottom: 8px;" />
                <ui:Toggle label="Reduce audio" name="reduceAudioToggle" style="margin-bottom: 8px;" />
                <ui:VisualElement name="conditionContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                    <ui:Label tabindex="-1" text="When" display-tooltip-when-elided="true" name="conditionTitleLabel" style="margin-bottom: 5px;" />
                    <ItemPicker name="modifierConditionPicker" class="controlWithLabelHorizontal" style="flex-direction: row; align-items: center; margin-bottom: 5px; width: 100%;" />
                    <ItemPicker name="modifierConditionFromNumberPicker" class="controlWithLabelHorizontal" style="flex-direction: row; align-items: center; margin-bottom: 5px; margin-left: auto; width: 100%;" />
                    <ItemPicker name="modifierConditionUntilNumberPicker" class="controlWithLabelHorizontal" style="flex-direction: row; align-items: center; margin-bottom: 5px; margin-left: auto; width: 100%;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="spacer" style="background-color: rgba(0, 0, 0, 0); height: 20px; flex-shrink: 0;" />
        <ui:VisualElement name="buttonRow" style="background-color: rgba(0, 0, 0, 0); width: 100%; align-items: center; flex-shrink: 0; flex-direction: row; justify-content: center; margin-top: auto;">
            <ui:Button display-tooltip-when-elided="true" name="randomizeModifiersButton" class="squareButton" style="margin-right: 10px;">
                <MaterialIcon tabindex="-1" icon="casino" name="randomizeIcon" />
            </ui:Button>
            <ui:Button display-tooltip-when-elided="true" name="resetModifiersButton" text="Reset" class="controlMinWidth" style="margin-right: 10px;" />
            <ui:Button text="OK" display-tooltip-when-elided="true" name="closeModifierDialogButton" class="controlMinWidth" style="margin-right: 10px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
