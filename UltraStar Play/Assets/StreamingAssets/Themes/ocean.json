{
    "defaultControl": {
        "fontColor": "#E5E5E5",
        "backgroundColor": "#3399D8",
        "hoverBackgroundColor": "#2E72F0",
        "focusBackgroundColor": "#2E72F0",
        "activeBackgroundColor": "#2C3CE6",
        "focusBorderColor": "#3399D8",
    },

    "transparentButton": {
        "backgroundColor": "#00000100",
        "hoverBackgroundColor": "#20202030",
        "focusBackgroundColor": "#20202040",
        "activeBackgroundColor": "#40404040",
        "textShadow": {
            "color": "#a0a0a0",
            "offset": {
                "x": 1,
                "y": 1
            },
        }
    },

   "dynamicPanel": {
       "backgroundColor": "#23304300",
       "hoverBackgroundColor": "#00a07e",
       "focusBackgroundColor": "#00a07e",
       "activeBackgroundColor": "#00a07e",
   },

    "staticPanel": {
        "backgroundGradient": "24deg, #233043, #344054",
    },

    "primaryFontColor": "#F0F0F0",
    "secondaryFontColor": "#CCCCCC",
    "noBackgroundInHierarchyTextShadow": {
        "color": "#a0a0a0",
        "offset": {
            "x": 1,
            "y": 1
        },
    },

    "staticBackground": {
        "impagePath": "backgrounds/black-10percent.png",
        "imageScaleMode": "StretchToFill",
    },
    
    "dynamicBackground": {
        "gradientRampFile": "gradients/ocean.png",
        "gradientType": "Linear",
        "gradientScale": 2.0,
        "gradientSmoothness": 0.8,
        "gradientAngle": 100,
        "gradientAnimation": true,
        "gradientAnimSpeed": 1.0,
        "gradientAnimAmplitude": 0.5,
        "particleFile": "particles/bubble.png",
        "particleOpacity": 0.3
    }
}