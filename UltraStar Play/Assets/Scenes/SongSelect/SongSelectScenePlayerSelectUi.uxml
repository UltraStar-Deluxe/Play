<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="PlayerSelectPlayerEntryUi" src="project://database/Packages/playshared/Runtime/UIDocuments/PlayerSelectPlayerEntryUi.uxml?fileID=9197481963319205126&amp;guid=ae611919e3b6a9e439070651ea79c54e&amp;type=3#PlayerSelectPlayerEntryUi" />    <ui:Template name="SongSelectSceneMicEntryUi" src="project://database/Assets/Scenes/SongSelect/SongSelectSceneMicEntryUi.uxml?fileID=9197481963319205126&amp;guid=95374f2e3150a184db1ca8e5b5bca617&amp;type=3#SongSelectSceneMicEntryUi" />
    <ui:VisualElement name="playerSelectOverlayContainer" style="width: 100%; height: 100%; position: absolute; align-items: center; justify-content: center; display: flex; background-color: rgba(32, 32, 32, 0.5);">
        <ui:VisualElement name="lyricsContainer" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%; align-items: flex-end; flex-direction: row;">
            <ui:VisualElement name="leftLyricsOverlay" class="roundCorners" style="position: absolute; left: 0; height: 90%; width: 30%; background-color: rgba(32, 32, 32, 0.88); padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 30px; display: flex;">
                <ui:Label text="Voice 1" display-tooltip-when-elided="true" name="voiceNameLabel" style="margin-bottom: 10px; -unity-font-style: bold;" />
                <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="lyricsScrollView">
                    <ui:Label text="These are the awesome&#10;lyrics of the song" display-tooltip-when-elided="true" name="lyricsLabel" class="smallFont" style="-unity-font-style: normal; flex-grow: 1;" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="rightLyricsOverlay" class="roundCorners" style="position: absolute; height: 90%; width: 30%; background-color: rgba(32, 32, 32, 0.88); padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 30px; right: 0; display: flex;">
                <ui:Label text="Voice 2" display-tooltip-when-elided="true" name="voiceNameLabel" style="margin-bottom: 10px; -unity-font-style: bold; -unity-text-align: upper-right;" />
                <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="lyricsScrollView" style="flex-grow: 1;">
                    <ui:Label text="These are the awesome&#10;lyrics of the song" display-tooltip-when-elided="true" name="lyricsLabel" class="smallFont" style="-unity-font-style: normal; -unity-text-align: upper-right;" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="playerSelectOverlay" class="roundCorners focusableNavigatorRoot" style="height: auto; width: 33%; background-color: rgba(32, 32, 32, 0.88); align-items: center; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; display: flex; flex-grow: 2; min-height: 60%;">
            <ui:VisualElement name="buttonRow" style="flex-direction: row; width: 100%; flex-shrink: 0; margin-bottom: 5px;">
                <ui:Button display-tooltip-when-elided="true" name="closePlayerSelectOverlayButton" class="squareButton" style="margin-right: 5px;">
                    <MaterialIcon name="closePlayerSelectOverlayIcon" icon="arrow_back" style="position: absolute; display: flex;" />
                </ui:Button>
                <ui:Button text="Start" display-tooltip-when-elided="true" name="playerSelectStartSongButton" style="width: auto; flex-grow: 1;" />
                <ui:Button text="Prepare&#10;Song" display-tooltip-when-elided="true" name="playerSelectCreateSongButton" class="smallFont" style="width: auto; flex-grow: 1; display: none;" />
                <ui:Button display-tooltip-when-elided="true" name="toggleSingingOptionsButton" class="squareButton" style="margin-left: 5px;">
                    <MaterialIcon name="settingsIcon" icon="settings" style="position: absolute;" />
                    <MaterialIcon name="playersIcon" icon="manage_accounts" style="position: absolute; display: none;" />
                </ui:Button>
                <ui:Button display-tooltip-when-elided="true" name="playerSelectOpenSongEditorButton" class="squareButton" style="margin-left: 5px;">
                    <MaterialIcon name="openSongEditorIcon" icon="edit" style="position: absolute;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="playerScrollView" style="width: 100%; flex-grow: 1; display: none;">
                <ui:Instance template="PlayerSelectPlayerEntryUi" name="playerEntry" />
                <ui:VisualElement name="partySettingsContainer" class="smallerFont" style="background-color: rgba(0, 0, 0, 0); flex-grow: 1; margin-bottom: 5px; margin-top: 5px;">
                    <ui:Label tabindex="-1" text="Party Settings" display-tooltip-when-elided="true" name="partySettingsTitleLabel" style="margin-left: auto; margin-right: auto;" />
                    <ui:VisualElement name="finishConditionContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; margin-left: 15px;">
                        <ui:Label tabindex="-1" text="•" display-tooltip-when-elided="true" name="dot" style="position: absolute; left: -10px;" />
                        <ui:Label tabindex="-1" text="Reach end of song" display-tooltip-when-elided="true" name="finishConditionDescription" />
                    </ui:VisualElement>
                    <ui:VisualElement name="unconditionalModifierConditionContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; margin-left: 15px;">
                        <ui:Label tabindex="-1" text="•" display-tooltip-when-elided="true" name="dot" style="position: absolute; left: -10px;" />
                        <ui:Label tabindex="-1" text="Pass the mic, Short song" display-tooltip-when-elided="true" name="unconditionalModifierDescription" style="margin-top: auto; white-space: normal;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="conditionalModifierConditionContainer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; margin-left: 15px;">
                        <ui:Label tabindex="-1" text="•" display-tooltip-when-elided="true" name="dot" style="position: absolute; left: -10px;" />
                        <ui:Label tabindex="-1" text="&apos;Hide lyrics&apos; when score is between 1000 and 9000" display-tooltip-when-elided="true" name="conditionalModifierDescription" style="margin-top: auto; white-space: normal;" />
                    </ui:VisualElement>
                    <ChipsCombo name="modifierChipsCombo" label="Modifiers" style="flex-direction: column; align-items: stretch;" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="singingOptionsScrollView" style="width: 100%; flex-grow: 1; display: flex;">
                <ui:VisualElement name="scoreModeContainer">
                    <ui:Label text="Score" display-tooltip-when-elided="true" name="scoreModeLabel" class="smallFont" />
                    <ItemPicker noPreviousButton="true" name="scoreModePicker" wrapAround="true" class="smallControl" style="width: auto;" />
                </ui:VisualElement>
                <ui:VisualElement name="noteDIsplayModeContainer">
                    <ui:Label text="Note Display Mode" display-tooltip-when-elided="true" name="noteDisplayModeLabel" class="smallFont" />
                    <ItemPicker noPreviousButton="true" name="noteDisplayModePicker" wrapAround="true" class="smallControl" style="width: auto;" />
                </ui:VisualElement>
                <ChipsCombo name="modifierChipsCombo" label="Modifiers" style="flex-direction: column; align-items: stretch;" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="micListOverlay" class="roundCorners" style="height: auto; width: 33%; background-color: rgba(32, 32, 32, 0.88); align-items: center; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 30px; display: flex; bottom: 0; margin-top: 5px; flex-grow: 1; min-height: 30%;">
            <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="micScrollView" style="width: 90%; flex-grow: 1;">
                <ui:Instance template="SongSelectSceneMicEntryUi" name="micEntry" />
            </ui:ScrollView>
            <ui:Label text="No microphone found" display-tooltip-when-elided="true" name="noMicsFoundLabel" style="position: absolute; width: 100%; height: 100%; -unity-text-align: middle-center; display: none; white-space: normal;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>