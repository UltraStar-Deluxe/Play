            </ui:VisualElement>
            <ui:Button name="deleteGameRoundButton" class="squareButton" style="position: absolute; right: 0; width: 24px; height: 24px; bottom: 0;">
                <MaterialIcon tabindex="-1" name="deleteIcon" icon="delete" picking-mode="Ignore" style="font-size: 20px;" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="playerEntryList" style="background-color: rgba(0, 0, 0, 0); flex-direction: row; flex-wrap: wrap; width: 100%;">
            <ui:Instance template="SongSelectGameRoundPlayerEntryUi" name="SongSelectGameRoundPlayerEntryUi" />
            <ui:Instance template="SongSelectGameRoundPlayerEntryUi" name="SongSelectGameRoundPlayerEntryUi" />
