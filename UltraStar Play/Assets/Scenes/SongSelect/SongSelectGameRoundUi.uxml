    <ui:VisualElement name="gameRoundUiRoot" class="roundCorners roundedCorners outline" style="flex-direction: column; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; width: 100%;">
        <ui:VisualElement name="songEntryList" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
            <ui:VisualElement name="songEntryListContent" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                <ui:Instance template="SongSelectGameRoundSongEntryUi" name="SongSelectGameRoundSongEntryUi" />
