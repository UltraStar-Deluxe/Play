<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="songEntryUiRoot" class="roundCorners" style="height: 99px;">
        <ui:VisualElement name="row" class="listItem dynamicPanel backgroundTransition" style="background-color: rgb(6, 170, 233); overflow: hidden; flex-direction: row-reverse; flex-grow: 1;">
            <ui:VisualElement name="songImageOuter" picking-mode="Ignore" style="background-image: url(&apos;project://database/Packages/playshared/Runtime/Graphics/NoCover.png?fileID=2800000&amp;guid=1d183c612f1866943a54609ced7fece7&amp;type=3#NoCover&apos;); -unity-background-scale-mode: scale-and-crop; flex-shrink: 0; min-width: 20px; min-height: 20px; height: 100px; width: 99px;">
                <ui:VisualElement name="songImageInner" picking-mode="Ignore" style="background-image: url(&apos;project://database/Packages/playshared/Runtime/Graphics/NoCover.png?fileID=2800000&amp;guid=1d183c612f1866943a54609ced7fece7&amp;type=3#NoCover&apos;); -unity-background-scale-mode: scale-to-fit; flex-grow: 1; display: none;" />
            </ui:VisualElement>
            <ui:VisualElement name="songInfoContainer" picking-mode="Ignore" style="min-height: 50px; flex-grow: 1; display: none;">
                <ui:Label text="Some very long song title" display-tooltip-when-elided="true" name="songTitle" picking-mode="Ignore" style="white-space: normal; -unity-font-style: bold;" />
                <ui:Label text="Some very very long artist name" display-tooltip-when-elided="true" name="songArtist" picking-mode="Ignore" class="smallFont secondaryFontColor" />
                <ui:VisualElement name="titleRow" picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; align-items: center;" />
                <ui:VisualElement name="iconBar" picking-mode="Ignore" class="mt-auto" style="flex-shrink: 0; align-items: center; flex-direction: row;">
                    <MaterialIcon name="songEntryFavoriteIcon" icon="favorite" class="smallFont fontColor secondaryFontColor" />
                    <ui:VisualElement name="songEntryDuetIcon" picking-mode="Ignore" class="fontColor secondaryFontColor" style="background-image: url(&apos;project://database/Assets/Common/Graphics/Icons/DuetIcon.png?fileID=2800000&amp;guid=ecea42b89d4de5f42a25fd1a598b26a1&amp;type=3#DuetIcon&apos;); width: 12px; height: 12px; flex-shrink: 0; display: flex; -unity-background-scale-mode: scale-to-fit;" />
                    <MaterialIcon name="songEntryNotSavedYetIcon" icon="auto_awesome" class="smallFont fontColor secondaryFontColor" />
                    <ui:VisualElement name="stars" class="ml-auto" style="background-color: rgba(0, 0, 0, 0); justify-content: center; flex-direction: row;">
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 14px;" />
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 14px;" />
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 14px;" />
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 14px;" />
                        <MaterialIcon tabindex="-1" icon="star" name="songRatingStarIcon" class="secondaryFontColor" style="font-size: 14px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="column" class="mr-1" style="justify-content: center; flex-shrink: 0; align-items: center; display: none;">
                <ui:Button display-tooltip-when-elided="true" name="openSongMenuButton" class="squareButton transparentBackgroundColor">
                    <MaterialIcon tabindex="-1" picking-mode="Ignore" name="openSongMenuIcon" icon="more_vert" style="font-size: 18px;" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
