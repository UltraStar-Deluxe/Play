<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="searchPropertyDialogRoot" style="flex-grow: 1;">
        <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="searchPropertyScrollView" style="flex-grow: 1;">
            <ui:Label text="Playlist" display-tooltip-when-elided="true" name="playlistChooserTitle" class="smallFont" style="margin-bottom: 5px;" />
            <ui:VisualElement name="row" class="mb-3" style="background-color: rgba(0, 0, 0, 0); width: 100%; flex-shrink: 0;">
                <ui:DropdownField choices="PlaylistA, PlaylistB" name="playlistDropdownField" class="mr-2 roundCorners" style="flex-grow: 1;" />
                <ui:Button display-tooltip-when-elided="true" name="createPlaylistButton" class="squareButton mr-2">
                    <MaterialIcon tabindex="-1" name="createPlaylistIcon" picking-mode="Ignore" icon="add" />
                </ui:Button>
                <ui:Button display-tooltip-when-elided="true" name="editPlaylistButton" class="squareButton">
                    <MaterialIcon tabindex="-1" name="editPlaylistIcon" picking-mode="Ignore" icon="edit" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label text="Order" display-tooltip-when-elided="true" name="orderChooserTitle" class="smallFont" style="margin-bottom: 5px;" />
            <ui:EnumField choices="Order by Title, Order by Artist" name="songOrderDropdownField" type="ESongOrder, Common" class="roundCorners mb-3" style="flex-grow: 1;" />
            <AccordionGroup>
                <AccordionItem label="Search In" name="searchPropertyAccordionItem" content-visible="false">
                    <ui:VisualElement name="toggles" class="child-mb-2" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
                        <ui:Toggle name="artistPropertyToggle" label="Artist" class="mt-2" />
                        <ui:Toggle name="titlePropertyToggle" label="Title" />
                        <ui:Toggle name="genrePropertyToggle" label="Genre" />
                        <ui:Toggle name="yearPropertyToggle" label="Year" />
                        <ui:Toggle name="languagePropertyToggle" label="Language" />
                        <ui:Toggle name="editionPropertyToggle" label="Edition" />
                        <ui:Toggle name="lyricsPropertyToggle" label="Lyrics" />
                    </ui:VisualElement>
                </AccordionItem>
                <AccordionItem name="filtersAccordionItem" label="Filter By" content-visible="false">
                    <ui:Toggle label="Duet" name="showOnlyDuetsToggle" class="mb-2 mt-2" />
                    <ui:VisualElement name="filterListContainer" class="child-mb-2" style="width: 100%; align-items: stretch;" />
                </AccordionItem>
                <AccordionItem name="advancedSearchAccordionItem" label="Advanced Search" content-visible="false">
                    <ui:Label text="Advanced search available" display-tooltip-when-elided="true" name="showSearchExpressionInfoTitle" class="smallFont" style="margin-bottom: 5px;" />
                    <ui:VisualElement style="align-items: auto; width: 100%;">
                        <ui:Button display-tooltip-when-elided="true" name="showSearchExpressionInfoButton" class="squareButton" style="width: auto; height: auto;">
                            <MaterialIcon name="helpIcon" icon="help_outline" />
                        </ui:Button>
                    </ui:VisualElement>
                </AccordionItem>
            </AccordionGroup>
        </ui:ScrollView>
        <ui:VisualElement name="buttonRow" class="mt-auto" style="justify-content: center; flex-shrink: 0;">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="resetActiveFiltersButton" class="squareButton">
                <MaterialIcon tabindex="-1" icon="replay" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
