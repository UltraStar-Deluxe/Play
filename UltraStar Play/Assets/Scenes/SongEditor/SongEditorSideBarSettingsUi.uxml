<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scenes/SongEditor/SongEditorStyles.uss?fileID=7433441132597879392&amp;guid=d010d6b3e8b73774591bb17f251cbb92&amp;type=3#SongEditorStyles" />
    <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="settingsSideBarContainer" vertical-scroller-visibility="AlwaysVisible" class="secondarySideBarPanel smallFont" style="display: flex;">
        <ui:Label text="Settings" display-tooltip-when-elided="true" name="settingsTitle" class="secondarySideBarTitle" style="-unity-text-align: upper-center; -unity-font-style: bold; display: flex;" />
        <SongEditorSideBarGroup name="editingGroup" label="Editing">
            <ui:Toggle name="adjustFollowingNotesToggle" label="Adjust Following Notes" />
            <ui:Toggle name="syncLyricsAreaToggle" label="Synchronize position&#10;with lyrics cursor&#10;" />
            <ui:Toggle name="autoSaveToggle" label="Auto Save" />
            <ItemPicker no-previous-button="true" name="drawNoteLayerPicker" wrap-around="true" label="Draw Notes on Layer" class="controlWithLabelVertical mb-2" style="flex-direction: column;" />
            <ui:IntegerField picking-mode="Ignore" value="100" text="300" name="spaceBetweenNotesTimeInMillisTextField" label="Space between notes (ms)" is-delayed="true" style="flex-direction: column;" />
            <ui:Button text="Add Space Between Notes&#10;in Selection" display-tooltip-when-elided="true" name="addSpaceBetweenNotesButton" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="musicGroup" label="Playback">
            <ui:Toggle name="goToLastPlaybackPositionToggle" label="Jump back on pause&#10;" />
            <ui:Slider picking-mode="Ignore" value="42" high-value="100" name="musicVolumeSlider" label="Volume" style="flex-direction: column;" />
            <ui:Slider picking-mode="Ignore" value="42" high-value="1.5" name="musicPlaybackSpeedSlider" low-value="0.5" label="Playback Speed" style="flex-direction: column;" />
            <ui:Button text="Reset Playback Speed" display-tooltip-when-elided="true" name="resetMusicPlaybackSpeedButton" />
            <ItemPicker name="playbackAudioPicker" no-previous-button="true" wrapAround="true" label="Playback Audio" class="controlWithLabelVertical" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="micRecordingGroup" label="Microphone">
            <ItemPicker no-previous-button="true" name="micDeviceItemPicker" wrap-around="true" label="Microphone" class="controlWithLabelVertical mb-2" style="flex-direction: column;" />
            <ui:TextField picking-mode="Ignore" value="300" text="300" name="micDelayTextField" is-delayed="true" label="Mic delay (ms)" style="flex-direction: column;" />
            <ui:Toggle name="speechRecognitionWhenRecordingToggle" label="Speech recognition while recording" />
            <ui:TextField picking-mode="Ignore" value="A#4" text="A#4" name="micRecordingPitchTextField" is-delayed="true" label="Default Pitch" class="smallControl" style="flex-grow: 1; flex-direction: column;" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="speechRecognitionGroup" label="Speech Recognition">
            <ui:EnumField label="Language (default: English)" type="EWhisperLanguage, Common" value="English" name="speechRecognitionLanguageChooser" style="flex-direction: column;" />
            <ui:TextField text="vosk-model-small-en-us-0.15" name="speechRecognitionModelPathTextField" is-delayed="true" label="Model Path" class="smallControl" style="flex-direction: column;" />
            <ui:Button text="Change Model Path" display-tooltip-when-elided="true" name="selectModelPathButton" />
            <ui:TextField name="speechRecognitionPromptTextField" is-delayed="true" multiline="true" label="Prompt with guidelines (optional)" class="smallFont multiline" style="white-space: normal; width: 100%; min-height: 120px; flex-direction: column;" />
            <ui:TextField name="speechRecognitionPhrasesTextField" is-delayed="true" multiline="true" label="Words to recognize" class="smallFont multiline" style="white-space: normal; width: 100%; min-height: 120px; flex-direction: column; display: none;" />
            <ItemPicker name="speechRecognitionAudioPicker" no-previous-button="true" wrapAround="true" label="Audio to Analyze" class="controlWithLabelVertical" />
            <ui:Button text="Analyze Speech&#10;in Selection" display-tooltip-when-elided="true" name="doSpeechRecognitionButton" style="width: 100%; height: auto;" />
            <ui:Toggle name="splitSyllablesAfterSpeechRecognitionToggle" label="Split syllables after&#10;speech recognition" />
            <ui:Button text="Split Syllables&#10;in Selection" display-tooltip-when-elided="true" name="splitSyllablesInSelectionButton" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="pitchDetectionGroup" label="Pitch Detection" style="display: none;">
            <ItemPicker no-previous-button="true" name="pitchDetectionAlgorithmItemPicker" wrapAround="true" label="Algorithm" class="smallControl controlWithLabelVertical" style="max-height: none; display: none;" />
            <ItemPicker name="pitchDetectionAudioPicker" no-previous-button="true" wrapAround="true" label="Audio to Analyze" class="controlWithLabelVertical" style="display: none;" />
            <ui:Button text="Detect Pitch&#10;in Selection (DyWa)" display-tooltip-when-elided="true" name="doPitchDetectionInSelectionButton" style="width: 100%; height: auto; display: none;" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="buttonRecordingGroup" label="Button Tapping">
            <ui:TextField value="N" text="N" name="buttonRecordingButtonTextField" is-delayed="true" label="Button for tapping" style="flex-direction: column;" />
            <ui:TextField value="A#4" text="A#4" name="buttonRecordingPitchTextField" is-delayed="true" label="Default pitch" style="flex-direction: column;" />
            <ui:TextField text="A#4" name="buttonRecordingLyricsTextField" is-delayed="true" label="Lyrics for button tapping" multiline="true" value="Lorem ipsum&#10;dolor met" class="multiline" style="flex-direction: column; min-height: 120px; white-space: normal;" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="midiGroup" label="MIDI">
            <ui:Toggle name="midiNotePlayAlongToggle" label="Play MIDI sounds" />
            <ui:Slider picking-mode="Ignore" value="42" high-value="10" name="midiGainSlider" label="Gain" style="flex-direction: column;" />
            <ui:Slider picking-mode="Ignore" value="42" high-value="127" name="midiVelocitySlider" label="Velocity" style="flex-direction: column;" />
            <ui:TextField picking-mode="Ignore" value="400" text="400" name="midiDelayTextField" label="Playback offset (ms)" style="flex-grow: 1; flex-direction: column;" />
            <ui:Button text="Import MIDI File" display-tooltip-when-elided="true" name="importMidiFileButton" style="width: 100%;" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="layoutGroup" label="Layout">
            <ui:Toggle name="showRightSideBarToggle" label="Show right side" />
            <ui:Toggle name="showAudioWaveformInBackgroundToggle" label="Show wave form" />
            <ui:Toggle name="showVideoAreaToggle" label="Show preview" />
            <ui:Toggle name="showVirtualPianoToggle" label="Show virtual piano" />
            <ui:Toggle name="showStatusBarToggle" label="Show status bar" />
            <ui:Toggle name="showControlHintsToggle" label="Show control hints" />
            <ui:Toggle name="showNotePitchLabelToggle" label="Show pitch on notes" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="gridGroup" label="Grid">
            <ui:TextField picking-mode="Ignore" value="2" text="2" name="gridSizeTextField" label="Stroke width" style="flex-direction: column;" />
            <ui:TextField picking-mode="Ignore" value="4" text="4" name="sentenceLineSizeTextField" label="Phrase separator width" style="flex-direction: column;" />
        </SongEditorSideBarGroup>
        <SongEditorSideBarGroup name="labelsGroup" label="Labels">
            <ItemPicker name="timeLabelFormatPicker" no-previous-button="true" wrapAround="true" label="Time Labels" class="controlWithLabelVertical" />
            <ItemPicker name="pitchLabelFormatPicker" no-previous-button="true" wrapAround="true" label="Pitch Labels" class="controlWithLabelVertical" />
        </SongEditorSideBarGroup>
    </ui:ScrollView>
</ui:UXML>