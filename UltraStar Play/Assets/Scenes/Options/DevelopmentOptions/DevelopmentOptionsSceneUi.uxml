<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="loadedOptionsRoot">
        <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1">
            <ui:VisualElement name="buttonRow" class="ml-auto mb-3" style="justify-content: flex-start;">
                <ui:Button text="View Log" display-tooltip-when-elided="true" name="showLogButton" class="controlMinWidth" style="margin-right: 5px;" />
                <ui:Button text="Copy Log" display-tooltip-when-elided="true" name="copyLogButton" class="controlMinWidth" style="margin-right: 5px;" />
                <ui:Button display-tooltip-when-elided="true" name="openPersistentDataPathButton" style="margin-right: 5px; flex-direction: row;">
                    <ui:Label tabindex="-1" text="Data Folder" display-tooltip-when-elided="true" name="openPersistentDataPathLabel" />
                    <MaterialIcon tabindex="-1" icon="open_in_new" name="openFolderIcon" />
                </ui:Button>
                <ui:Button display-tooltip-when-elided="true" name="openWebViewScriptsPathButton" style="margin-right: 5px; flex-direction: row;">
                    <ui:Label tabindex="-1" text="Browser Scripts" display-tooltip-when-elided="true" name="openWebViewScriptsPathLabel" />
                    <MaterialIcon tabindex="-1" icon="open_in_new" name="openFolderIcon" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Toggle name="showFpsToggle" label="Show FPS" class="noBackgroundInHierarchy" />
            <ItemPicker name="portAudioHostApiPicker" label="PortAudio Host API¹" wrap-around="true" min-value="0" max-value="100" step-value="10" class="noBackgroundInHierarchy" />
            <ItemPicker name="portAudioOutputDevicePicker" label="PortAudio output device" wrap-around="true" min-value="0" max-value="100" step-value="10" class="noBackgroundInHierarchy" />
            <ui:Button text="Show PortAudio Devices" display-tooltip-when-elided="true" name="portAudioDeviceInfoButton" style="align-self: flex-end;" />
            <ui:Toggle name="playRecordedAudioToggle" label="Play recorded audio" style="margin-bottom: 0;" />
            <ui:VisualElement name="playRecordedAudioInfoContainer" class="mb-3" style="flex-direction: row; align-items: center;">
                <MaterialIcon tabindex="-1" name="infoIcon" icon="info_outline" class="smallFont mr-1 nBackgroundInHierarchy" />
                <ui:Label tabindex="-1" text="Does not work with Companion App" name="playRecordedAudioInfoLabel" class="smallFont playRecordedAudioInfoContainer" />
            </ui:VisualElement>
            <ItemPicker name="micPlaybackVolumeChooser" label="Microphone Playback Volume" wrap-around="true" min-value="0" max-value="1000" step-value="10" />
            <ItemPicker name="systemAudioBackendDelayPicker" label="System audio backend delay" wrap-around="true" min-value="0" max-value="500" step-value="10" />
            <ItemPicker name="useVlcToPlayMediaFilesPicker" label="Use VLC to play audio&#10;and video files¹" wrap-around="true" min-value="0" max-value="100" step-value="10" class="noBackgroundInHierarchy" />
            <ui:Toggle name="logVlcOutputToggle" label="Log VLC output" class="noBackgroundInHierarchy" />
            <ItemPicker name="useFfmpegToPlayMediaFilesPicker" label="Use ffmpeg to play audio&#10;and video files (unstable)¹" wrap-around="true" min-value="0" max-value="100" step-value="10" class="noBackgroundInHierarchy" />
            <ui:Toggle name="logFfmpegOutputToggle" label="Log ffmpeg output" class="noBackgroundInHierarchy" />
            <ui:Toggle name="checkCodecIsSupportedToggle" label="Check codecs are supported.&#10;(slower song search)" class="noBackgroundInHierarchy" />
            <ItemPicker name="maxConcurrentSongMediaConversionsPicker" label="Max concurrent conversions" wrap-around="true" min-value="0" max-value="100" step-value="1" class="noBackgroundInHierarchy" />
            <ui:TextField picking-mode="Ignore" label="ffmpeg conversion commands&#10;(JSON)" name="ffmpegConversionCommandsJsonPicker" is-delayed="true" multiline="true" class="noBackgroundInHierarchy multiline" style="align-items: center; flex-grow: 1; margin-bottom: 4px; min-height: 100px;" />
            <ui:TextField picking-mode="Ignore" label="Absolute path to folder&#10;with generated files¹" name="generatedFolderPathTextField" is-delayed="true" class="noBackgroundInHierarchy" style="align-items: center; flex-grow: 1; margin-bottom: 4px;">
                <ui:Label tabindex="-1" text="Default path" display-tooltip-when-elided="true" name="generatedFolderPathHintLabel" class="textFieldHint secondaryFontColor" style="left: auto; right: 10px;" />
            </ui:TextField>
            <ItemPicker name="minimumLogLevelPicker" label="Minimum Log Level¹" wrap-around="true" class="noBackgroundInHierarchy" />
            <ui:IntegerField name="messageBufferTimeTextField" label="Message Buffer Time (ms)&#10;for Companion App" value="150" class="noBackgroundInHierarchy mb-3" />
            <ItemPicker name="pitchDetectionAlgorithmPicker" label="Pitch Detection Algorithm" wrap-around="true" min-value="0" max-value="100" step-value="10" class="multiline noBackgroundInHierarchy" />
            <ui:Toggle name="analyzeBeatsWithoutTargetNoteToggle" label="Analyze Beats Without Target Note" class="noBackgroundInHierarchy" />
            <ui:Toggle name="animatedBackgroundItemToggle" label="Animated Background¹" class="noBackgroundInHierarchy" />
            <ui:Toggle name="enableDynamicThemesToggle" label="Enable Themes¹" class="noBackgroundInHierarchy" />
            <ui:Toggle name="disableWebViewToggle" label="Disable embedded browser¹" wrapAround="true" class="noBackgroundInHierarchy" />
            <ui:Toggle name="useUniversalCharsetDetectorToggle" label="Use Universal Charset Detector.&#10;Better but slower detection of&#10;non-Unicode encodings¹" stepValue="10" wrap-around="true" class="noBackgroundInHierarchy" />
            <ui:Toggle name="customEventSystemOptInOnAndroidToggle" label="Use custom event system&#10;for input actions.&#10;This enables keyboard&#10;and gamepad control&#10;but can cause issues on Android¹" wrapAround="true" minValue="0" maxValue="100" stepValue="10" wrap-around="true" class="noBackgroundInHierarchy" />
            <ui:TextField text="python -m spleeter" name="audioSeparationCommandTextField" is-delayed="true" label="Spleeter Command&#10;(audio separation)" class="noBackgroundInHierarchy mb-3" style="flex-grow: 1;" />
            <ui:TextField text="python -m spleeter" name="basicPitchCommandTextField" is-delayed="true" label="Basic Pitch Command&#10;(pitch detection)" class="noBackgroundInHierarchy mb-3" style="flex-grow: 1;" />
            <ui:IntegerField label="Connection Port¹&#10;(default 34567)" name="clientDiscoveryPortTextField" value="34567" class="noBackgroundInHierarchy mb-3" />
            <ui:Label text="Connection endpoint: ????" name="connectionEndpointLabel" class="controlLabel optionsLabelAndItemPicker noBackgroundInHierarchy" />
            <ui:TextField label="HTTP Server Host¹&#10;(leave empty for automatic value)" name="httpServerHostTextField" class="noBackgroundInHierarchy mb-3" />
            <ui:IntegerField label="HTTP Server Port¹&#10;(default: 6789)" name="httpServerPortTextField" class="noBackgroundInHierarchy mb-3" />
            <ui:Label text="HTTP endpoint example: ????" name="httpEndpointExampleLabel" class="controlLabel optionsLabelAndItemPicker noBackgroundInHierarchy" style="margin-bottom: 10px;" />
            <ui:VisualElement name="separator" class="horizontalSeparatorLine" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);" />
            <ui:Label tabindex="-1" text="¹ requires restart" display-tooltip-when-elided="true" name="requiresRestartLabel" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
