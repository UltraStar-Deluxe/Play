<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="connectedClientListEntryUiRoot" style="width: auto; justify-content: space-between; border-bottom-color: rgb(255, 255, 255); border-bottom-width: 1px; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; align-items: stretch;">
        <ui:VisualElement name="topRow" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; align-items: center;">
            <MaterialIcon name="clientIcon" icon="phone_iphone" />
            <ui:Label text="My Connected App" name="clientNameLabel" style="-unity-font-style: bold; font-size: 20px; overflow: hidden; margin-right: 20px; flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="permissionsContainer" style="background-color: rgba(0, 0, 0, 0); flex-wrap: wrap; flex-direction: row; justify-content: space-between;">
            <ui:Toggle label="DummyPermission" name="dummyPermissionToggle" />
            <ui:Toggle label="DummyPermission" name="dummyPermissionToggle" />
            <ui:Toggle label="DummyPermission" name="dummyPermissionToggle" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
