<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Shadow>
        <ui:VisualElement name="card" class="song-package-card default-pack">
            <ui:Label text="Default Songs" name="title" class="mb-2" style="-unity-font-style: bold;"/>
            <ui:Label text="Lorem ipsum dolor sit amet, te dolorum pericula sit. Sint tritani eu est, ex his affert appetere voluptatibus,te duo oporteat legendos." name="description" class="smallFont" style="white-space: normal;"/>
            <ui:VisualElement name="row" class="mt-3" style="flex-grow: 1;">
                <ui:Label text="https://example.com/example-song-package.zip" name="url" class="smallFont mr-2 tinyFont" style="white-space: normal; flex-grow: 1; flex-shrink: 1;"/>
                <ui:Button text="Enable" name="actionButton" style="min-width: 120px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </Shadow>
</ui:UXML>
