<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="teamUiRoot" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: row; align-items: center;">
        <MaterialIcon tabindex="-1" icon="emoji_events" name="trophyIcon" style="font-size: 92px; color: rgb(176, 177, 52); -unity-font-style: normal;" />
        <ui:VisualElement name="labelContainer" style="flex-grow: 1; background-color: rgb(0, 175, 0); flex-direction: row; border-top-left-radius: 10px; border-top-right-radius: 10px; padding-left: 20px; padding-right: 20px; padding-top: 5px; padding-bottom: 10px; align-items: flex-end;">
            <ui:Label tabindex="-1" text="Team 01, Team 02, Team 03, Team 04, Team 05" display-tooltip-when-elided="true" name="teamNameLabel" class="ellipsis" style="-unity-font-style: bold; font-size: 32px; margin-right: 20px; flex-shrink: 1;" />
            <ui:VisualElement name="spacer" style="flex-grow: 1; width: 20px; height: 100%; flex-shrink: 0;" />
            <ui:Label tabindex="-1" text="99" display-tooltip-when-elided="true" name="teamScoreLabel" style="-unity-font-style: bold; font-size: 32px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
