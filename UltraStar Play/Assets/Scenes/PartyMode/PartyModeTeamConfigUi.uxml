<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="PartyModeTeamColumnUi" src="project://database/Assets/Scenes/PartyMode/PartyModeTeamColumnUi.uxml?fileID=9197481963319205126&amp;guid=1372ae0a2e4e4904d907d6afc58462ff&amp;type=3#PartyModeTeamColumnUi" />
    <ui:Template name="PartyModeTeamColumnPlayerUi" src="project://database/Assets/Scenes/PartyMode/PartyModeTeamColumnPlayerUi.uxml?fileID=9197481963319205126&amp;guid=2b8c5e1f85d2b1d4390343734d5b3ffc&amp;type=3#PartyModeTeamColumnPlayerUi" />
    <ui:VisualElement name="teamConfigUiRoot" class="overlay" style="justify-content: flex-start; align-items: flex-start;">
        <ui:VisualElement name="topRow" style="background-color: rgba(0, 0, 0, 0); flex-direction: row; width: 100%; flex-shrink: 0;">
            <ui:Label tabindex="-1" text="Teams" display-tooltip-when-elided="true" name="teamConfigTitleLabel" class="titleText" style="flex-grow: 1; -unity-font-style: bold;" />
            <ui:Button text="Add Team" display-tooltip-when-elided="true" name="addTeamButton" style="margin-right: 5px;" />
            <ui:Button text="Add Guest" display-tooltip-when-elided="true" name="addGuestButton" />
        </ui:VisualElement>
        <ui:VisualElement name="centerContent" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); width: 100%; align-items: stretch; margin-bottom: 5px; margin-top: 5px;">
            <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="teamsScrollView" class="overlayBackground roundCorners" style="min-height: 0; min-width: 50%; margin-left: 10px; margin-right: 10px; flex-grow: 1; flex-direction: column; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px;">
                <ui:VisualElement name="teamColumnsContainer" style="background-color: rgba(0, 0, 0, 0); flex-direction: row;">
                    <ui:Instance template="PartyModeTeamColumnUi" name="PartyModeTeamColumnUi" style="flex-grow: 1;">
                        <ui:Instance template="PartyModeTeamColumnPlayerUi" name="PartyModeTeamColumnPlayerUi" />
                        <ui:Instance template="PartyModeTeamColumnPlayerUi" name="PartyModeTeamColumnPlayerUi" />
                    </ui:Instance>
                    <ui:Instance template="PartyModeTeamColumnUi" name="PartyModeTeamColumnUi" style="flex-grow: 1;">
                        <ui:Instance template="PartyModeTeamColumnPlayerUi" name="PartyModeTeamColumnPlayerUi" />
                    </ui:Instance>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="bottomContent" style="background-color: rgba(0, 0, 0, 0); margin-left: auto; flex-shrink: 0;">
            <ui:Toggle label="Free-for-all" name="freeForAllToggle" style="min-width: 33%; margin-bottom: 5px;" />
            <ui:Toggle label="Knock-out tournament" name="knockOutTournamentToggle" style="min-width: 33%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
