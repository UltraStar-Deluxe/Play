<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="roundUi" style="justify-content: flex-start; align-items: flex-start; padding-bottom: 10px; border-left-color: rgba(255, 255, 255, 0.5); border-right-color: rgba(255, 255, 255, 0.5); border-top-color: rgba(255, 255, 255, 0.5); border-bottom-color: rgba(255, 255, 255, 0.5);">
        <ui:VisualElement name="topRow" class="roundCorners" style="background-color: rgba(197, 197, 197, 0.5); flex-direction: row; width: 100%; flex-shrink: 0; margin-bottom: 5px; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px;">
            <ui:Button display-tooltip-when-elided="true" name="toggleRoundExpandedButton" class="squareButton transparentBackgroundColor">
                <MaterialIcon tabindex="-1" name="toggleRoundExpandedIcon" icon="expand_less" picking-mode="Ignore" />
            </ui:Button>
            <ui:Label tabindex="-1" text="01" display-tooltip-when-elided="true" name="roundTitleLabel" style="-unity-font-style: bold; -unity-text-align: middle-left; margin-right: 10px; font-size: 20px;" />
            <ui:Button display-tooltip-when-elided="true" name="deleteRoundButton" class="squareButton">
                <MaterialIcon tabindex="-1" icon="delete" name="deleteIcon" />
            </ui:Button>
            <ui:VisualElement name="spacer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);" />
            <ui:Button name="randomizeButton" class="squareButton" style="margin-right: 5px;">
                <MaterialIcon tabindex="-1" name="randomizeIcon" icon="casino" />
            </ui:Button>
            <ui:Button text="Save Preset" name="savePresetButton" />
            <ui:Button text="Delete Preset" name="deletePresetButton" />
            <ItemPicker name="presetItemPicker" style="margin-left: 5px;" />
        </ui:VisualElement>
        <ui:VisualElement name="centerContent" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); margin-left: auto; margin-right: auto; align-items: stretch; width: 100%; padding-left: 5px; padding-right: 5px;">
            <ItemPicker name="finishConditionPicker" label="Finish Condition" class="controlWithLabelHorizontal" style="flex-direction: row; align-items: center; margin-bottom: 5px; width: 100%;" />
            <ItemPicker name="finishConditionPointsPicker" class="controlWithLabelHorizontal" style="flex-direction: row; align-items: center; margin-bottom: 5px; margin-left: auto; width: 50%;" />
            <ChipsCombo name="modifierChipsCombo" label="Modifier" class="controlWithLabelHorizontal" style="margin-bottom: 5px;" />
            <ItemPicker name="modifierConditionPicker" label="Modifier Condition" class="controlWithLabelHorizontal" style="flex-direction: row; align-items: center; margin-bottom: 5px; width: 100%;" />
            <ItemPicker name="modifierConditionFromNumberPicker" class="controlWithLabelHorizontal" style="flex-direction: row; align-items: center; margin-bottom: 5px; margin-left: auto; width: 50%;" />
            <ItemPicker name="modifierConditionUntilNumberPicker" class="controlWithLabelHorizontal" style="flex-direction: row; align-items: center; margin-bottom: 5px; margin-left: auto; width: 50%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
