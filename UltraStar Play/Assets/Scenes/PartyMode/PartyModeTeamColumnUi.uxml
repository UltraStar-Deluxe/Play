    <ui:VisualElement name="teamColumnUiRoot" style="justify-content: flex-start; align-items: stretch; flex-grow: 1; border-left-color: rgba(255, 255, 255, 0.5); border-right-color: rgba(255, 255, 255, 0.5); border-top-color: rgba(255, 255, 255, 0.5); border-bottom-color: rgba(255, 255, 255, 0.5); padding-left: 5px; padding-right: 5px; min-width: 200px;">
