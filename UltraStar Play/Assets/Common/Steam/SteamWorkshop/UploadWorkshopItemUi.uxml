<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" class="child-mb-2">
        <ui:DropdownField name="workshopItemChooser" choices="New Item" style="flex-grow: 1;" />
        <ui:VisualElement name="row" style="flex-shrink: 0;">
            <ui:TextField name="workshopItemFolderTextField" is-delayed="true" style="align-items: center; flex-grow: 1; flex-shrink: 1;">
                <ui:Label tabindex="-1" text="Enter path to content folder" display-tooltip-when-elided="true" name="workshopItemFolderTextFieldHint" picking-mode="Ignore" class="textFieldHint secondaryFontColor" />
            </ui:TextField>
            <ui:Button name="selectWorkshopItemFolderButton" class="comboButton comboBoxButton squareButton">
                <MaterialIcon picking-mode="Ignore" name="selectFolderIcon" icon="folder_open" />
            </ui:Button>
            <ui:Button name="openWorkshopItemFolderButton" class="comboButton squareButton ml-1">
                <MaterialIcon picking-mode="Ignore" name="selectFolderIcon" icon="open_in_new" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="row" style="flex-shrink: 0;">
            <ui:TextField name="workshopItemImageTextField" is-delayed="true" style="align-items: center; flex-shrink: 1; flex-grow: 1;">
                <ui:Label tabindex="-1" text="Enter path to preview image" display-tooltip-when-elided="true" name="workshopItemImageTextFieldHint" picking-mode="Ignore" class="textFieldHint secondaryFontColor" />
            </ui:TextField>
            <ui:Button name="selectWorkshopItemImageButton" class="comboButton comboBoxButton squareButton">
                <MaterialIcon picking-mode="Ignore" name="selectImageIcon" icon="image" />
            </ui:Button>
        </ui:VisualElement>
        <ui:TextField label="Title" name="workshopItemTitleTextField" style="align-items: center;" />
        <ui:TextField label="Description" name="workshopItemDescriptionTextField" multiline="true" class="multiline" style="align-items: center; min-height: 32px;" />
        <ui:TextField label="Tags&#10;(comma separated)" name="workshopItemTagCsvTextField" style="align-items: center;" />
        <ui:VisualElement name="infoContainer" style="align-items: center; flex-shrink: 0; justify-content: center; flex-direction: row;">
            <MaterialIcon icon="info_outline" name="infoIcon" class="mr-1" style="font-size: 18px;" />
            <ui:Label text="Info Label" name="infoLabel" class="smallFont" />
        </ui:VisualElement>
        <ui:Label text="75 %" name="uploadProgressLabel" style="-unity-text-align: upper-center;" />
    </ui:VisualElement>
</ui:UXML>
