<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="PlayerProfileListEntryUi" src="project://database/Assets/Common/UI/PlayerProfileListEntryUi.uxml?fileID=9197481963319205126&amp;guid=02348618f8cffba42864c8979a4bd8ba&amp;type=3#PlayerProfileListEntryUi" />
    <ui:VisualElement name="onlineMultiplayerDialogUiRoot" class="overlay modalDialogContainer">
        <ui:VisualElement name="dialogContent" class="focusableNavigatorRoot dialogBackground roundCorners" style="width: 682px; height: 468px; justify-content: flex-start; align-items: center; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; max-height: 380px;">
            <ui:VisualElement name="row" class="mb-2" style="width: 100%; align-items: center;">
                <ui:VisualElement name="tabGroup" class="child-mr-1" style="align-items: flex-start; flex-direction: row;">
                    <ToggleButton text="Join Online Game" parse-escape-sequences="true" display-tooltip-when-elided="true" name="joinOnlineGameTabButton" />
                    <ToggleButton text="Host Online Game" parse-escape-sequences="true" display-tooltip-when-elided="true" name="hostOnlineGameTabButton" />
                </ui:VisualElement>
                <ui:Button display-tooltip-when-elided="true" name="defaultCloseDialogButton" class="circle transparentButton ml-auto" style="padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; width: 25px; height: 25px;">
                    <MaterialIcon tabindex="-1" picking-mode="Ignore" name="closeIcon" icon="close" class="noTextShadow" style="font-size: 20px;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="dialogContentContainer" horizontal-scroller-visibility="Hidden" style="flex-grow: 1; width: 100%; padding-left: 10px; padding-right: 10px;">
                <ui:VisualElement name="joinOnlineGameControlsContainer" class="child-mb-2">
                    <ui:VisualElement name="row" style="flex-grow: 1; justify-content: center;" />
                    <ui:Label tabindex="-1" text="Available Online Games" parse-escape-sequences="true" display-tooltip-when-elided="true" name="hostedGameListTitle" class="m-1 borderBottom" style="-unity-text-align: upper-center;" />
                    <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="hostedGameListScrollView" style="max-height: 400px;">
                        <ui:VisualElement name="hostedGameList" class="child-mb-2" style="flex-grow: 1;">
                            <ui:Button text="Join &quot;Player01&apos;s Game&quot;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="joinHostedGameButton" />
                            <ui:Button text="Join &quot;Player02&apos;s Game&quot;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="joinHostedGameButton" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:VisualElement name="row">
                        <ui:TextField picking-mode="Ignore" label="Password for&#10;hidden game" name="joinHiddenGamePasswordField" style="flex-grow: 1;" />
                        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="searchHostedGamesButton" class="squareButton comboBoxButton">
                            <MaterialIcon tabindex="-1" name="searchLobbiesIcon" icon="search" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Button text="Join Directly (without Steam)" parse-escape-sequences="true" display-tooltip-when-elided="false" name="joinOnlineGameDirectlyButton" />
                </ui:VisualElement>
                <ui:VisualElement name="hostOnlineGameControlsContainer" class="child-mb-2">
                    <ui:TextField picking-mode="Ignore" label="Name" name="hostGameNameField" />
                    <ui:Toggle label="Hidden" name="hostHiddenGameToggle" />
                    <ui:TextField picking-mode="Ignore" label="Password for&#10;hidden game" name="hostHiddenGamePasswordField" />
                    <ui:Button text="Host Online Game" parse-escape-sequences="true" display-tooltip-when-elided="false" name="hostOnlineGameButton" />
                    <ui:Button text="Host Directly (without Steam)" parse-escape-sequences="true" display-tooltip-when-elided="false" name="hostOnlineGameDirectlyButton" />
                </ui:VisualElement>
                <ui:VisualElement name="currentConnectionControlsContainer" class="child-mb-2">
                    <ui:VisualElement name="row" style="flex-grow: 1; justify-content: center;">
                        <ui:Label tabindex="-1" text="Members of &quot;Player01&apos;s Game&quot;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="connectedClientsListTitle" class="borderBottom" />
                    </ui:VisualElement>
                    <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="connectedClientsListScrollView" class="flexWrapScrollView">
                        <ui:Instance template="PlayerProfileListEntryUi" name="PlayerProfileListEntryUi" />
                        <ui:Instance template="PlayerProfileListEntryUi" name="PlayerProfileListEntryUi" />
                        <ui:Instance template="PlayerProfileListEntryUi" name="PlayerProfileListEntryUi" />
                    </ui:ScrollView>
                    <ui:Button text="Leave Lobby" parse-escape-sequences="true" display-tooltip-when-elided="true" name="disconnectOnlineGameButton" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement name="buttonRow" style="flex-direction: row; justify-content: center; width: 100%; flex-shrink: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
