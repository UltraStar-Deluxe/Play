<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="joinNetcodeLobbyUiRoot" class="child-mb-2">
        <ui:TextField picking-mode="Ignore" label="Ip Address" value="127.0.0.1" name="unityTransportIpAddressField" />
        <ui:IntegerField label="Port" value="7777" name="unityTransportPortField" />
        <ui:Button text="Join Directly (without Steam)" parse-escape-sequences="true" display-tooltip-when-elided="false" name="joinOnlineGameDirectlyButton" />
    </ui:VisualElement>
</ui:UXML>
